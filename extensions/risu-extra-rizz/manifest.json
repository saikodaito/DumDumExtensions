    "lua-vendor.js",
    "triggers.js",
    "prompt.js",
    "editor.js",
    "main.js"
  ],
  "styles": [
    "style.css"
  ],
  "assets": [
    "LICENSE",
    "lua/glue.wasm",
    "lua/json.lua",
    "lua/LICENSE-wasmoon.txt"
  ],
  "i18n": {
    "pt": "i18n/pt.json",
    "en": "i18n/en.json"
  },
  "permissions": {
    "network": [
      "sv.risuai.xyz"
    ],
    "prompt": true,
    "input": true,
    "chatRead": true,
    "chatWrite": true,
    "llm": true,
