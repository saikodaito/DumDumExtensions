{
  "id": "asset-probe",
  "name": {
    "en": "Asset Probe",
    "pt": "Sonda de Assets"
  },
  "version": "0.1.0",
  "api": 2,
  "minApp": "1.30.0",
  "author": "saikodaito",
  "summary": {
    "en": "Example of the API 2 hooks: keeps a card's images in its own storage and shows them in the chat.",
    "pt": "Exemplo dos ganchos da API 2: guarda as imagens de um card no armazenamento próprio e mostra no chat."
  },
  "platforms": [
    "desktop",
    "mobile"
  ],
  "defaultLang": "en",
  "storage": "own",
  "scripts": [
    "main.js"
  ],
  "styles": [
    "style.css"
  ],
  "i18n": {
    "pt": "i18n/pt.json",
    "en": "i18n/en.json"
  },
  "permissions": {
    "network": [
      "sv.risuai.xyz"
    ],
    "prompt": false,
    "chatRead": false,
    "ui": [
      "settings"
    ]
  },
  "restart": {
    "enable": false,
    "disable": false
  }
}
